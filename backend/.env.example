APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3100","http://127.0.0.1:3100"]
IMPORT_MAX_FILE_SIZE_BYTES=10485760
IMPORT_MAX_ARCHIVE_EXPANDED_BYTES=52428800
IMPORT_MAX_CONCURRENT_JOBS=3
PDF_RENDER_TIMEOUT_MS=30000
PDF_MAX_CONCURRENT_RENDERS=2
PDF_RENDER_QUEUE_TIMEOUT_SECONDS=8
REDIS_URL=redis://redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=FlowCV

AI_RATE_LIMIT_ENABLED=true
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_HOUR=50
AI_JD_ANALYSIS_PER_HOUR=10
AI_ATS_ANALYSIS_PER_HOUR=10
AI_TAILORING_PER_HOUR=5

AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300
AI_PROVIDER_HEALTH_TTL_SECONDS=900
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENT_PROVIDER_REQUESTS=4
AI_MAX_REQUEST_BYTES=262144
AI_MAX_RESUME_BYTES=131072
AI_MAX_RESUME_TEXT_CHARS=60000
AI_MAX_JD_CHARS=20000
AI_MAX_OPERATIONS=10
AI_MAX_OUTPUT_CHARS=30000
AI_PROMPT_VERSION=v2
AI_IDENTITY_SECRET=replace-with-a-random-local-secret
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXY_HOSTS=["127.0.0.1","::1"]
